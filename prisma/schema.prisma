generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         String           @default("Viewer")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignedClients Client[]      @relation("AssignedClients")
  notes        ClientNote[]
  activities   ClientActivity[]

  @@index([role])
  @@index([active])
}

model StudioSettings {
  id                String   @id @default("studio")
  studioName        String
  email             String
  phone             String   @default("")
  website           String   @default("")
  address           String   @default("")
  projectDeadlines  Boolean  @default(true)
  paymentReminders  Boolean  @default(true)
  newLeads          Boolean  @default(true)
  weeklyDigest      Boolean  @default(false)
  appearance        String   @default("dark")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PipelineStage {
  id        String   @id
  name      String
  slug      String   @unique
  color     String
  sortOrder Int
  kind      String   @default("custom")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clients   Client[]

  @@index([sortOrder])
}

model Client {
  id             String           @id @default(cuid())
  clientNumber   String           @unique
  name           String
  company        String
  industry       String           @default("")
  email          String           @default("")
  phone          String           @default("")
  potentialValue Float            @default(0)
  source         String           @default("")
  assignedUserId String?
  assignedUser   User?            @relation("AssignedClients", fields: [assignedUserId], references: [id], onDelete: SetNull)
  stageId        String           @default("stage_possible")
  stage          PipelineStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  status         String           @default("Lead")
  tags           String           @default("[]")
  notes          String           @default("")
  sortOrder      Int              @default(0)
  lastActivity   DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  projects       Project[]
  payments       Payment[]
  events         CalendarEvent[]
  clientNotes    ClientNote[]
  activities     ClientActivity[]

  @@index([status])
  @@index([company])
  @@index([stageId])
  @@index([assignedUserId])
  @@index([source])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model ClientActivity {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  fromStage String   @default("")
  toStage   String   @default("")
  reason    String   @default("")
  body      String   @default("")
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model Project {
  id         String          @id @default(cuid())
  name       String
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String
  budget     Float
  deadline   DateTime
  status     String
  progress   Int             @default(0)
  notes      String          @default("")
  checklist  String          @default("[]")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  payments   Payment[]
  events     CalendarEvent[]

  @@index([clientId])
  @@index([status])
  @@index([deadline])
}

model Payment {
  id            String   @id @default(cuid())
  date          DateTime
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount        Float
  status        String
  method        String
  invoiceNumber String   @unique
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([date])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  type      String
  notes     String   @default("")
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type])
}
